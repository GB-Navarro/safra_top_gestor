# Ambiente e arquivos locais
.venv/
__pycache__/
*.py[cod]
.env
.env.*
!.env.example
~$*

# Insumos baixados/exportados e produtos gerados ficam locais.
/data/raw/**
!/data/raw/**/
!/data/raw/**/.gitkeep
/data/interim/**
!/data/interim/**/
!/data/interim/**/.gitkeep
/outputs/**
!/outputs/**/
!/outputs/**/.gitkeep

# Tabelas que receberao observacoes ou estimativas podem incluir dados licenciados.
/data/processed/observations.csv
/data/processed/sources.csv
/data/processed/assumptions.csv
/data/processed/claims.csv
/data/processed/adjustments.csv
/data/processed/corporate_actions.csv
/data/processed/coverage.csv
/data/processed/estimate_snapshots.csv
/data/processed/*.json

# Apresentações publicadas: exceções explícitas para os artefatos solicitados.
!/outputs/draft/apresentacao_esg.pptx
!/outputs/draft/apresentacao_esg.pdf
!/outputs/draft/apoio_tecnico.pptx
!/outputs/draft/apoio_tecnico.pdf
!/outputs/draft/html/apresentacao_esg.html
!/outputs/draft/html/apresentacao_esg.pdf
!/outputs/draft/html/apresentacao_esg.pptx
